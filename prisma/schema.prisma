// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model EmailChangeTokens {
  token      String   @id @db.Char(21)
  newEmail   String
  userId     Int      @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  validUntil DateTime @db.Timestamp(6)
  @@map("email_change_tokens")
}

model EmailVerificationTokens {
  token      String   @id @db.Char(21)
  userId     Int      @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  validUntil DateTime @db.Timestamp(6)
  @@map("email_verification_tokens")
}

model PasswordResetTokens {
  token      String   @id @db.Char(21)
  userId     Int      @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  validUntil DateTime @db.Timestamp(6)
  @@map("password_reset_tokens")
}


model User {
  id Int @id @default(autoincrement())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  email    String @unique
  password String

  first_name String
  last_name  String
  phone String @default("")

  document_id String? @unique
  tax_id String? @unique

  pagadito_costumer_id String?

  emailChange       EmailChangeTokens?
  emailVerification EmailVerificationTokens?
  passwordReset     PasswordResetTokens?

  id_image IdDocumentImage?
  tax_id_image TaxDocumentImage?

  image             String?
  emailVerified     Boolean            @default(false)
  documentsValid    Boolean            @default(false)

  donations Donation[]

  institutions Institution[]

  payments Payment[]

  access_tokens AccessToken[]

  @@map("users")
}

model IdDocumentImage {
  id Int @id @default(autoincrement())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  front String
  back String

  valid     Boolean            @default(false)

  userId Int @unique
  user User @relation(fields: [userId], references: [id], onDelete:Cascade)

  @@map("id_document_images")
}

model TaxDocumentImage {
  id Int @id @default(autoincrement())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  front String
  back String

  valid     Boolean            @default(false)

  userId Int @unique
  user User @relation(fields: [userId], references: [id], onDelete:Cascade)

  @@map("tax_document_images")
}

model Donation {
  id Int @id @default(autoincrement())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  amount Decimal @default(0.0)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("donations")
}

model LandingImages {
  id Int @id @default(autoincrement())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  name    String
  alt_name String
  image   String

  @@map("landing_images")
}

model SiteInfo {
  id Int @id @default(autoincrement())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  about_us String @db.Text

  mission String @db.Text

  vision String @db.Text

  values String @db.Text

  @@map("site_info")
}

model Contact {
  id Int @id @default(autoincrement())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  name    String
  email   String
  phone   String
  role    String
  message String @db.Text

  @@map("contacts")
}

model Institution {
  id Int @id @default(autoincrement())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  name    String
  email   String
  phone   String
  address String
  image   String
  description String @db.Text
  number_students Int

  adminId Int
  admin   User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("institutions")
}

model TeamMember {
  id Int @id @default(autoincrement())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  name    String
  position   String
  image   String

  @@map("team_members")
}

model Payment {
  id Int @id @default(autoincrement())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  amunt     Decimal
  status    String
  method    String
  currency  String
  method_id String

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model SiteStats {
  id Int @id @default(autoincrement())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  title       String  
  total       Int     @default(0)
  description String 
  image       String

  @@map("site_stats")
}

model AccessToken {
  id             Int             @id @unique @default(autoincrement())
  created_at     DateTime        @default(now())
  updated_at     DateTime         @updatedAt
  userId         Int
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashed_token   String          @db.VarChar(100)
  name           String
  expires_at     DateTime
  revoked        Boolean         @default(false)
  refresh_tokens RefreshToken?

  @@map("access_tokens")
}

model RefreshToken {
  id              Int           @id @unique @default(autoincrement())
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  hashed_token    String        @db.VarChar(100)
  expires_at      DateTime
  revoked         Boolean       @default(false)
  access_token_id Int @unique
  access_tokens   AccessToken @relation(fields: [access_token_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}
